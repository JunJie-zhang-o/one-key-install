#horizontal_pb {
    /* color:pink; */
    height:auto;
}

OKIRichLog RichLog {
    /* border:hkey $primary; */

    border-title-style: italic;
    border-subtitle-style: italic;
    border-top: solid $primary;
    /* border-bottom: solid */
    /* padding: 5 0 5 0; */
}

OKIRichLog MarkdownViewer{
    padding: 0 0 1 0;
}
OKIRichLog OKIProgressBar{
    padding: 1 0 0 0 ;
}

#oki-status-bar{
    height: 1fr;
}
#app-horizontal {
    height: 4fr;
}
#bar{
    /* color: aquamarine; */
    width: auto;
    /* border: solid red; */
}

#oki-pb{
    /* width: 100%; */
    /* border: solid red;  */
}
#oki-pb-pb{
    width: 100%;
    /* border: solid blue;  */
}
ProgressBar{
    layout:grid;
    grid-size:3;
    grid-columns:80% 6% 14%
}
OKIListItem{
    height: 1;
}


OKIStatusBar{
    layout: grid;
    grid-size: 3;   
}

OKITipsScreen {
    align: center middle;
}
#tips-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

OKITipsScreen  Label {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}
OKITipsScreen  Button {
    content-align: center middle;
    width: 100%;
}

Button.-error.-active{
    /* background: red; */
}